# ====================================================================
# Campus Placement Management System (CPMS) — Environment Configuration
# ====================================================================

# 1. PostgreSQL Database URL
# For Cloud PostgreSQL (e.g., Neon.tech - recommended free tier):
#   DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# For Supabase:
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# For Local PostgreSQL:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_placement?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# 2. Authentication Secret (Used for signing secure session cookies)
# Generate a secure 32+ character string (e.g., via `openssl rand -base64 32`)
AUTH_SECRET="cpms-super-secret-key-change-this-in-production-min-32-chars-long"

# 3. Application Public URL
APP_URL="http://localhost:3000"
